SQL> -- day-15
SQL> -- 1. Create a trigger that when the new record is inserted in the Movie table
SQL> ed
Wrote file afiedt.buf

  1  CREATE OR REPLACE TRIGGER movie_t1
  2  AFTER
  3  insert -- when use trigger 'insert or update or delete'
  4  on
  5  movie -- table name
  6  begin
  7  	dbms_output.put_line('Your movie record is inserted ' || :NEW.MOVIE_NAME);
  8* end
SQL> /
CREATE OR REPLACE TRIGGER movie_t1
                          *
ERROR at line 1:
ORA-04082: NEW or OLD references not allowed in table level triggers 


SQL> ed
Wrote file afiedt.buf

  1  CREATE OR REPLACE TRIGGER movie_t1
  2  AFTER
  3  insert -- when use trigger 'insert or update or delete'
  4  on
  5  movie -- table name
  6  for each row -- trigger for all row
  7  begin
  8  	dbms_output.put_line('Your movie record is inserted ' || :NEW.MOVIE_NAME);
  9  	-- :NEW.column_name show new record
 10* end
SQL> /

Warning: Trigger created with compilation errors.

