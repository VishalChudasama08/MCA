SQL> -- 3. Write a Cursor to find the first 3 rankers based on the total marks.
SQL> ed
Wrote file afiedt.buf

  1  declare
  2  	nm student1.name%type;
  3  	t student1.total%type;
  4  	g student1.grade%type;
  5  	count number;
  6  	cursor cur is select name,total,grade from student order by total desc;
  7  begin
  8  	count:=0;
  9  	open cur;
 10  		loop
 11  			fetch cur into nm,t,g;
 12  			exit when count=3 or cur%NOTFOUND;
 13  			count:=count+1;
 14  			dbms_output.put_line(nm || ' ' || t || ' ' || g);
 15  		end loop;
 16  	close cur
 17* end;
SQL> /
end;
