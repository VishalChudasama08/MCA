Wrote file afiedt.buf

  1  DECLARE
  2      nm Student1.Name%TYPE;
  3      t Student1.Total%TYPE;
  4      count_num NUMBER := 0;  -- Changed variable name from COUNT to count_num
  5      CURSOR cur IS 
  6          SELECT Name, Total 
  7          FROM Student1 
  8          ORDER BY Total DESC;  -- Removed Grade as it is not inserted in the table
  9  BEGIN
 10      OPEN cur;
 11      LOOP
 12          FETCH cur INTO nm, t;
 13          EXIT WHEN count_num = 3 OR cur%NOTFOUND;
 14          count_num := count_num + 1;
 15          DBMS_OUTPUT.PUT_LINE(nm || ' ' || t);  -- Outputs Name and Total
 16      END LOOP;
 17      CLOSE cur;
 18* END;
SQL> /
